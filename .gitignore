# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# graphify (knowledge graph) — derived outputs, regenerate with /graphify
# .gd_mirror kept OUT of gitignore's reach for graphify itself via .graphifyignore — see that file
.gd_mirror/
graphify-out/

# Local-only audit/progress-tracking docs — not meant to be committed
code_review.txt

# Plan docs — local-only, not meant to be committed. Files already tracked
# before this line was added (e.g. plans/AI_DIFFICULTY_PLAN.md,
# plans/POST_BATTLE_SUMMARY_PLAN.md, plans/SNOW_REWORK_PLAN.md) stay tracked
# until explicitly untracked (git rm --cached) — gitignore only stops NEW
# files from being picked up.
plans/
